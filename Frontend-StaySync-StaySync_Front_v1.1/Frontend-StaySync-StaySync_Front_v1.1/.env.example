# ─────────────────────────────────────────────────────────────────────────────
# StaySync Frontend — Variables de entorno Vite
# Copiar a .env y rellenar los valores reales (NUNCA subir .env a git)
# ─────────────────────────────────────────────────────────────────────────────

# MercadoPago — Public Key (Sandbox)
# Obtener en: mercadopago.com/developers → Credenciales → Sandbox → Public Key
# El valor de sandbox empieza con TEST-
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URLs de microservicios
# Desarrollo local
VITE_BFF_URL=http://localhost:8080/bff
VITE_PAGOS_URL=http://localhost:8085

# Producción (AWS)
# VITE_BFF_URL=https://api.tudominio.com/bff
# VITE_PAGOS_URL=https://api.tudominio.com/pagos
