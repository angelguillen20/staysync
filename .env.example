# ─────────────────────────────────────────────────────────────────────────────
# StaySync — Variables de entorno
# Copiar a .env y rellenar los valores reales (NUNCA subir .env a git)
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos MySQL (compartido por todos los servicios)
MYSQL_ROOT_PASSWORD=cambiar_en_produccion
MYSQL_USER=staysync
MYSQL_PASSWORD=cambiar_en_produccion

# JWT (debe ser el mismo valor en todos los servicios)
JWT_SECRET=cambiar_por_un_secreto_de_al_menos_64_caracteres_aleatorios

# Cifrado AES-256 a nivel de persistencia (usuarios-service, AesGcmStringConverter).
# Debe ser una clave de 32 bytes codificada en Base64. Generar con:
#   openssl rand -base64 32
# En producción, obtener de AWS Secrets Manager / KMS, no de un .env.
AES_ENCRYPTION_KEY=cambiar_por_una_clave_aes256_de_32_bytes_en_base64

# Stripe (solo pagos-service)
STRIPE_SECRET_KEY=sk_test_...

# Correo (notificaciones-service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_de_gmail
